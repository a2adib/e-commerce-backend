# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/ecommerce_local

# Application Security
SECRET_KEY=dev-super-secret-key-change-in-production-123456
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_SETUP_KEY=change-me-admin-setup-key

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Storage & Uploads
STORAGE_DIR=uploads
BASE_URL=http://localhost:8000

# CORS Origins (comma-separated or JSON list on a single line)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Optional Integrations
SENTRY_DSN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VERCEL_BLOB_TOKEN=
FIREBASE_CREDENTIALS_PATH=
FIREBASE_STORAGE_BUCKET=
